{
  "name": "dsh-whale-pet",
  "version": "1.0.0",
  "description": "小鲸鱼桌宠：在 DSH 界面浮层里游来游去的宠物，会眨眼、打盹、跟随时段说话",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "whale"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a643036114-sys/dsh-whale-pet.git"
  },
  "homepage": "https://github.com/a643036114-sys/dsh-whale-pet#readme",
  "scripts": {
    "verify": "node dev/verify-bundle.mjs lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
